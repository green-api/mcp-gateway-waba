{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.greenapi/whatsapp-waba",
  "title": "Green API WhatsApp Business (WABA)",
  "description": "MCP gateway for the official WhatsApp Business API via Green API — send template and session messages, manage message templates, receive notifications.",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/green-api/mcp-gateway-waba",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp-waba.green-api.com/mcp",
      "headers": [
        {
          "name": "X-Instance-Id",
          "description": "Green API instance ID",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "X-Api-Token",
          "description": "Green API instance token",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "type": "sse",
      "url": "https://mcp-waba.green-api.com/sse",
      "headers": [
        {
          "name": "X-Instance-Id",
          "description": "Green API instance ID",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "X-Api-Token",
          "description": "Green API instance token",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
